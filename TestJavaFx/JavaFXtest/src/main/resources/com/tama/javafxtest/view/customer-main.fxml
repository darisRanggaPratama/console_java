<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tama.javafxtest.controller.CustomerMainController">
   <top>
      <VBox spacing="10.0" styleClass="header">
         <children>
            <Label text="Customer Management System" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Search:" textFill="WHITE" />
                  <TextField fx:id="searchField" prefWidth="300.0" promptText="Search by NIK, Name, Born, Active, or Salary..." />
                  <Button fx:id="searchButton" onAction="#handleSearch" text="Search" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                  <Button fx:id="clearSearchButton" onAction="#handleClearSearch" text="Clear" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="addButton" onAction="#handleAdd" text="Add Customer" styleClass="button-primary" />
                  <Button fx:id="uploadCsvButton" onAction="#handleUploadCsv" text="Upload CSV" style="-fx-background-color: #f39c12; -fx-text-fill: white;" />
                  <Button fx:id="downloadCsvButton" onAction="#handleDownloadCsv" text="Download CSV" style="-fx-background-color: #e67e22; -fx-text-fill: white;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="Rows per page:" />
                  <ComboBox fx:id="rowsPerPageComboBox" onAction="#handleRowsPerPageChange" prefWidth="80.0" />
               </children>
            </HBox>
            <TableView fx:id="customerTable" onMouseClicked="#handleTableClick">
               <columns>
                  <TableColumn fx:id="idxColumn" prefWidth="60.0" text="ID" />
                  <TableColumn fx:id="nikColumn" prefWidth="100.0" text="NIK" />
                  <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Name" />
                  <TableColumn fx:id="bornColumn" prefWidth="120.0" text="Born" />
                  <TableColumn fx:id="activeColumn" prefWidth="80.0" text="Active" />
                  <TableColumn fx:id="salaryColumn" prefWidth="120.0" text="Salary" />
               </columns>
            </TableView>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="previousButton" onAction="#handlePrevious" text="Previous" />
                  <Label fx:id="pageInfoLabel" text="Page 1 of 1" />
                  <Button fx:id="nextButton" onAction="#handleNext" text="Next" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="recordCountLabel" text="Total: 0 records" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>