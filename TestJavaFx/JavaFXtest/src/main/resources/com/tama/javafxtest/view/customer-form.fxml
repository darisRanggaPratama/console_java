<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tama.javafxtest.controller.CustomerFormController">
   <children>
      <Label text="Customer Information">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Separator />
      <GridPane hgap="10.0" vgap="15.0">
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
         <children>
            <Label text="NIK:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nikField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Born:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <DatePicker fx:id="bornDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Active:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <CheckBox fx:id="activeCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Salary:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="salaryField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </GridPane>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="saveButton" onAction="#handleSave" text="Save" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
            <Button fx:id="deleteButton" onAction="#handleDelete" text="Delete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" visible="false" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>